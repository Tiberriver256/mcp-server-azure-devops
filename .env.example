# Azure DevOps MCP Server - Environment Variables

# Azure DevOps Organization URL (required)
# Cloud:   https://dev.azure.com/your-organization
# On-prem: https://server:8080/tfs/DefaultCollection
AZURE_DEVOPS_ORG_URL=https://dev.azure.com/your-organization

# Authentication Method (optional, defaults to 'azure-identity')
# Supported values: 'pat', 'azure-identity', 'azure-cli'
# - 'pat': Personal Access Token authentication (Cloud & Azure DevOps Server on-prem)
# - 'azure-identity': Azure Identity authentication (DefaultAzureCredential, Cloud only)
# - 'azure-cli': Azure CLI authentication (AzureCliCredential, Cloud only)
AZURE_DEVOPS_AUTH_METHOD=azure-identity

# Azure DevOps Personal Access Token (required for PAT authentication)
# Create one at: https://dev.azure.com/your-organization/_usersSettings/tokens
# Recommended scopes (enable only what your selected toolsets need):
#   Code (Read & Write), Work Items (Read & Write), Build (Read & Execute),
#   Project and Team (Read), Graph (Read), Release (Read & Execute),
#   Wiki (Read & Write), Test Management (Read & Write)
AZURE_DEVOPS_PAT=your-personal-access-token

# Default Project to use when not specified in tool arguments (optional)
AZURE_DEVOPS_DEFAULT_PROJECT=your-default-project

# REST API Version for direct REST calls (optional, defaults to 7.1)
# For older Azure DevOps Server versions, set e.g. 6.0 or 5.1
# AZURE_DEVOPS_API_VERSION=7.1

# Optional tool filtering & fail-closed read-only mode
# AZURE_DEVOPS_TOOLSETS=all
# AZURE_DEVOPS_ENABLED_TOOLS=
# AZURE_DEVOPS_DISABLED_TOOLS=
# AZURE_DEVOPS_READ_ONLY=false

# Logging level (debug, info, warn, error; defaults to info).
# Setting 'debug' prints sanitized startup configuration to stderr.
# AZURE_DEVOPS_LOG_LEVEL=info

# Azure Identity Credentials (only required for azure-identity with a service principal)
# AZURE_TENANT_ID=your-tenant-id
# AZURE_CLIENT_ID=your-client-id
# AZURE_CLIENT_SECRET=your-client-secret