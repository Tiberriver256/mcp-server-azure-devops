{
  "name": "@tiberriver256/mcp-server-azure-devops",
  "version": "0.1.56",
  "description": "Azure DevOps reference server for the Model Context Protocol (MCP)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tiberriver256/mcp-server-azure-devops"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server-azure-devops": "./dist/index.js"
  },
  "files": [
    "dist/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.ts": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "release-please": {
    "release-type": "node",
    "changelog-types": [
      {
        "type": "feat",
        "section": "Features",
        "hidden": false
      },
      {
        "type": "fix",
        "section": "Bug Fixes",
        "hidden": false
      },
      {
        "type": "chore",
        "section": "Miscellaneous",
        "hidden": false
      },
      {
        "type": "docs",
        "section": "Documentation",
        "hidden": false
      },
      {
        "type": "perf",
        "section": "Performance Improvements",
        "hidden": false
      },
      {
        "type": "refactor",
        "section": "Code Refactoring",
        "hidden": false
      }
    ]
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build && chmod +x dist/index.js",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector@0.9.0 node dist/index.js",
    "test": "npm run test:unit && npm run test:int && npm run test:e2e",
    "test:unit": "jest --config jest.unit.config.js",
    "test:prop": "jest --config jest.unit.config.js --testMatch='**/*.spec.prop.ts' --coverage=false",
    "test:diff": "jest --config jest.unit.config.js --testMatch='**/*.spec.diff.ts' --coverage=false",
    "test:int": "jest --config jest.int.config.js",
    "test:e2e": "jest --config jest.e2e.config.js",
    "test:watch": "jest --watch",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky",
    "commit": "commit"
  },
  "keywords": [
    "azure-devops",
    "mcp",
    "ai",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "axios": "^1.21.1",
    "azure-devops-node-api": "^17.0.2",
    "diff": "^9.0.0",
    "dotenv": "^18.0.10",
    "jszip": "^3.10.2",
    "minimatch": "^11.0.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "^0.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/prompt-cli": "^21.2.4",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "fast-check": "^4.11.0",
    "husky": "^9.1.7",
    "jest": "^30.5.1",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "ts-jest": "^29.4.15",
    "tsrs": "^7.1.0-beta.tsrs5",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "overrides": {
    "@istanbuljs/load-nyc-config": {
      "js-yaml": "^4.1.0"
    }
  }
}
