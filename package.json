{
  "name": "@tiberriver256/mcp-server-azure-devops",
  "version": "0.2.0",
  "description": "Azure DevOps reference server for the Model Context Protocol (MCP)",
  "repository": {
    "type": "git",
    "url": "https://github.com/Tiberriver256/mcp-server-azure-devops"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "mcp-server-azure-devops": "./dist/index.js"
  },
  "files": [
    "dist/",
    "docs/",
    "LICENSE",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.ts": [
      "oxfmt",
      "oxlint --fix"
    ]
  },
  "release-please": {
    "release-type": "node",
    "changelog-types": [
      {
        "type": "feat",
        "section": "Features",
        "hidden": false
      },
      {
        "type": "fix",
        "section": "Bug Fixes",
        "hidden": false
      },
      {
        "type": "chore",
        "section": "Miscellaneous",
        "hidden": false
      },
      {
        "type": "docs",
        "section": "Documentation",
        "hidden": false
      },
      {
        "type": "perf",
        "section": "Performance Improvements",
        "hidden": false
      },
      {
        "type": "refactor",
        "section": "Code Refactoring",
        "hidden": false
      }
    ]
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc",
    "typecheck": "tsc --noEmit && npm run typecheck:tests",
    "typecheck:tests": "tsc -p tsconfig.test.json --noEmit",
    "prepack": "npm run build && chmod +x dist/index.js",
    "dev": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --watch src/index.ts",
    "start": "node dist/index.js",
    "inspector": "npm run build && npx @modelcontextprotocol/inspector@2.16.0 -- node dist/index.js",
    "test": "npm run test:unit",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.spec.{unit,prop,diff}.ts\"",
    "test:coverage": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --experimental-test-coverage --test-coverage-lines=70 --test-coverage-branches=50 --test-coverage-functions=60 --test-coverage-include=\"src/**/*.ts\" --test-coverage-exclude=\"src/**/*.spec.*.ts\" --test-coverage-exclude=\"src/**/__test__/**\" --test-coverage-exclude=\"src/shared/test/**\" --test-coverage-exclude=\"src/shared/types/**\" --test-coverage-exclude=\"src/**/types.ts\" \"src/**/*.spec.{unit,prop,diff}.ts\"",
    "test:prop": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.spec.prop.ts\"",
    "test:diff": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.spec.diff.ts\"",
    "test:matrix": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"tests/matrix/**/*.spec.ts\"",
    "test:e2e:offline": "node --test \"tests/e2e-suite/**/*.test.mjs\"",
    "test:int": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/setup.ts --test --test-concurrency=1 --test-timeout=30000 \"src/**/*.spec.int.ts\"",
    "test:e2e": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./tests/setup.ts --test --test-timeout=30000 \"src/**/*.spec.e2e.ts\"",
    "test:watch": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test --watch \"src/**/*.spec.{unit,prop,diff}.ts\"",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "format": "oxfmt \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "oxfmt --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepare": "husky",
    "commit": "commit"
  },
  "keywords": [
    "azure-devops",
    "mcp",
    "ai",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.14.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "azure-devops-node-api": "^17.0.2",
    "diff": "^9.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/oxlint-config": "^0.2.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/prompt-cli": "^21.2.4",
    "@types/node": "^26.6.7",
    "fast-check": "^4.11.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tsrs": "^7.1.0-beta.tsrs5",
    "typescript": "^7.0.2"
  }
}
